{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "9ce95f82a1c84c938924bd3cdc8eb6dc",
    "m_Title": "Vectra card",
    "m_Content": "A rounded card made with Vectra's distance field, anti-aliasing and paint, in a plain Shader Graph. Change Shape, Size and Roundness in the SDF Shape node; Pixels = 1 on the Outline node keeps the outline 2 screen pixels wide at any scale. Use the Vectra Sub Graphs (Vectra > ...) for the same nodes with named inputs.",
